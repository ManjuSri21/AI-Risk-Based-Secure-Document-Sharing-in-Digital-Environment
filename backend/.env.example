PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/secureshare
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173
UPLOAD_DIR=uploads
ADMIN_MASTER_KEY=replace-with-a-long-random-secret-used-to-encrypt-admin-key-material

# Backend defaults to Gmail SMTP on port 587. Use a Google App Password,
# not your normal account password.
SMTP_USER=your-account@gmail.com
SMTP_PASS=your-16-character-app-password

